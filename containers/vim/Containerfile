# Vim Container with AI Assistant
# Complete vim setup with LSP, AI, and plugins
# Based on Fedora 44

FROM registry.fedoraproject.org/fedora:44

LABEL maintainer="vim-ai-assistant"
LABEL description="Vim with AI assistant, LSP (ALE), and plugins"

# Install vim and all dependencies
RUN dnf install -y \
    vim-enhanced \
    vim-ale \
    python3-lsp-server \
    gopls \
    nodejs-bash-language-server \
    rust-analyzer \
    vim-fugitive \
    vim-gitgutter \
    vim-nerdtree \
    vim-ctrlp \
    vim-commentary \
    vim-rhubarb \
    vim-trailing-whitespace \
    vim-powerline \
    git \
    python3 \
    python3-google-genai \
    curl \
    && dnf clean all

# Create non-root user
ARG USER_UID=1000
ARG USER_GID=1000
ARG USERNAME=vimuser

RUN groupadd -g ${USER_GID} ${USERNAME} && \
    useradd -m -u ${USER_UID} -g ${USER_GID} -s /bin/bash ${USERNAME}

USER ${USERNAME}
WORKDIR /home/${USERNAME}

# Copy vim configuration
COPY --chown=${USERNAME}:${USERNAME} vimrc /home/${USERNAME}/.vimrc

# Copy AI helper script
COPY --chown=${USERNAME}:${USERNAME} vim-ai-helper /home/${USERNAME}/.local/bin/
RUN chmod +x /home/${USERNAME}/.local/bin/vim-ai-helper

# Set up environment
ENV PATH="/home/${USERNAME}/.local/bin:${PATH}"
ENV VIM_AI_BACKEND=ollama
ENV EDITOR=vim

# Mount points for workspace
VOLUME ["/workspace"]
WORKDIR /workspace

ENTRYPOINT ["vim"]
CMD ["--help"]
